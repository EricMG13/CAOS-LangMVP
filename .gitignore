# OS
.DS_Store

# Editor
.vscode/

# Node / Next.js (caos/frontend)
node_modules/
.pnpm-store/
.next/
.next-qa*/
.next-*/
caos/frontend/next-env.d.ts
out/
*.tsbuildinfo

# Python (deploy_v vendored skills, contracts.py, caos/deploy scripts)
__pycache__/
*.pyc
.venv*/

# Secrets / local env
.env
.env.local
caos/deploy/rclone.conf

# Test artifacts
.pytest_cache/
coverage/
caos/frontend/test-results/
caos/frontend/playwright-report/
caos/frontend/private/

# Local static-analysis databases and diagnostics
/static_analysis_codeql_*/

# impeccable hook cache (generated per app dir) — design.json is the one
# tracked exception, mirroring the legacy repo's convention.
**/.impeccable/*
!**/.impeccable/design.json

# QA harness secrets, generated on first use by qa/env.sh — never committed.
qa/.secrets

# `uv run --project caos/server` writes a uv.lock beside pyproject.toml. The
# committed locks are caos/server/requirements{,-dev}.txt (hashed, generated by
# `uv pip compile`); uv.lock is a local by-product of running the suite and has
# never been the source of truth here.
caos/server/uv.lock
