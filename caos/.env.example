# Example environment for caos/deploy/docker-compose.yml.
# Copy to caos/.env, replace every change-me, and never commit the copy.

# Public entry
CAOS_DOMAIN=caos.example.com
CAOS_EMAIL_DOMAIN=example.com
MAX_UPLOAD_MB=250

# Data plane
POSTGRES_PASSWORD=change-me-postgres

# Trusted edge (Caddy -> oauth2-proxy -> app); both must be long random values
EDGE_PROXY_SECRET=change-me-edge-secret
SESSION_SECRET=change-me-session-secret

# OIDC via oauth2-proxy. Cookie secret must be exactly 16, 24, or 32 bytes
# (e.g. `openssl rand -hex 16`); the placeholder below is 32 ASCII bytes.
OAUTH2_PROXY_CLIENT_ID=caos
OAUTH2_PROXY_CLIENT_SECRET=change-me-oauth-client-secret
OAUTH2_PROXY_COOKIE_SECRET=change-me-cookie-32-byte-secret!
OAUTH2_PROXY_OIDC_ISSUER_URL=https://issuer.example.com/realms/caos

# Agent (LLM) execution — fail-closed: stays off until both are set
AGENT_EXECUTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Legacy pilot toggles passed through to the containers (unread by the MVP)
CPDR_AGENT_ENABLED=false
CANONICAL_AGENT_ENABLED=false
CPDR_PILOT_CASE_IDS=
CPDR_PILOT_SUBJECTS=
