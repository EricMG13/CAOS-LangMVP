# Example environment for caos/deploy/docker-compose.yml.
# Copy to caos/.env, fill every required value (and the Anthropic/qualification
# values only when enabling agent execution), and never commit the copy. The
# required secrets ship EMPTY on purpose: Compose's `${VAR:?}` refuses to start
# on an unset or empty value, so a half-filled .env fails closed instead of
# booting production on a predictable placeholder. Generate each with
# `openssl rand -hex 32` (the cookie secret must be exactly 16, 24, or 32 bytes
# — `openssl rand -hex 16`).

# Public entry
CAOS_DOMAIN=caos.example.com
CAOS_EMAIL_DOMAIN=example.com
MAX_UPLOAD_MB=32
# What one governed source may be. The route refuses above this; the edge cap
# above is only the transport ceiling.
MAX_SOURCE_MB=25

# Data plane
POSTGRES_PASSWORD=

# Trusted edge (Caddy -> oauth2-proxy -> app); both must be long random values
# (>= 32 characters — the app refuses to start in production otherwise)
EDGE_PROXY_SECRET=
SESSION_SECRET=

# OIDC via oauth2-proxy.
OAUTH2_PROXY_CLIENT_ID=caos
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_OIDC_ISSUER_URL=https://issuer.example.com/realms/caos

# Agent (LLM) execution — fail-closed. Production agent execution requires the
# flag, Anthropic credential, and a separately provisioned digest-bound
# qualification record. The app may boot with execution disabled, but it never
# substitutes placeholder analysis. Never commit the qualification record.
AGENT_EXECUTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CAOS_PROVIDER_QUALIFICATION_PATH=
CAOS_PROVIDER_QUALIFICATION_DIGEST=

# Legacy pilot toggles passed through to the containers (unread by the MVP)
