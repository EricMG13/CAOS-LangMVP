{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "caos-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "caos/frontend"],
      "port": 3000
    },
    {
      "name": "caos-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "caos/server", "python", "caos/server/dev.py"],
      "port": 8000,
      "autoPort": true
    }
  ]
}
